# Copy to .env in the repo root for backend-only operator keys.
# The app does not copy these into browser storage.
# A key typed in the app is stored in the OS keyring when available,
# or in backend process memory for this session when it is not.
# Placeholders only — never commit a real key.

OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# OPENAI_MODEL=gpt-4o
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=

